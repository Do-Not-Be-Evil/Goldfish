{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": [ "ES2022", "DOM", "DOM.Iterable" ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "rootDir": "Scripts",
    "outDir": "wwwroot/js",
    "sourceMap": true,
    "removeComments": false
  },
  "include": [ "Scripts/**/*.ts" ]
}
