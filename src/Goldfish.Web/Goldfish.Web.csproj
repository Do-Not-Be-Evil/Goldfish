<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Goldfish.Web</RootNamespace>
    <UserSecretsId>goldfish-web-9c2a7e45</UserSecretsId>
    <!-- TypeScript in Scripts/ is compiled to wwwroot/js on build (see tsconfig.json). -->
    <TypeScriptCompileBlocked>false</TypeScriptCompileBlocked>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="7.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Goldfish.Application\Goldfish.Application.csproj" />
    <ProjectReference Include="..\Goldfish.Infrastructure\Goldfish.Infrastructure.csproj" />
  </ItemGroup>

</Project>
