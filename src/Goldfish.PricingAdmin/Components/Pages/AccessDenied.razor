@page "/access-denied"
@attribute [Authorize]

<PageTitle>Access denied</PageTitle>
<h1>Access denied</h1>
<p>
    You are signed in, but your account has neither the <code>@PricingRoles.Analyst</code> nor the
    <code>@PricingRoles.Manager</code> role for this app. Ask the app registration owner to assign one in Entra ID.
</p>
